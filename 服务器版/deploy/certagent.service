[Unit]
Description=CertAgent Backend (FastAPI + Uvicorn)
# 断电重启保护：等网络真正就绪（network-online，替代原来 network.target，
# 避免开机时网卡还没 up 就抢跑）+ 关闭 StartLimit 次数限制。
# 另见同目录 certagent_ready.sh（ExecStartPre 等依赖探测）。
After=network-online.target
Wants=network-online.target
# 断电重启场景：关闭默认「10s 内失败 5 次即永久 failed」的限制，
# 只要下次尝试就能拉起。StartLimit* 必须写在 [Unit] 段，写在 [Service] 会被忽略。
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=hisense
Group=hisense
WorkingDirectory=/home/hisense/pro/Gitlab/CertAgent
Environment="HOME=/home/hisense"
Environment="PATH=/home/hisense/pro/Gitlab/CertAgent/venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/home/hisense/pro/Gitlab/CertAgent/venv/bin/uvicorn webapi.app:app --host 127.0.0.1 --port 8125 --workers 1
# 启动前做依赖就绪探测（网络 ≤30s + 内网 LLM 网关 ≤60s，超时降级不阻塞）。
ExecStartPre=/home/hisense/pro/Gitlab/CertAgent/deploy/certagent_ready.sh
Restart=always
RestartSec=8

# 日志
StandardOutput=journal
StandardError=journal

# ExecStartPre 可能等待（30+60+2s），默认 90s 会误杀。
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target