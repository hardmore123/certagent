# suggester 模式：mock（工程测试，不调用 LLM）| llm（真 LLM）
SUGGESTER_MODE=mock

# OpenAI 兼容 LLM 接口。示例配置：
#
# DeepSeek 官方（2026-07 后 deepseek-chat 已废弃，使用 v4 新命名）：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-你的DeepSeekKey
#   LLM_MODEL=deepseek-v4-flash        # 快速版，$0.14/$0.28 per 1M tokens，归纳任务够用
#   # LLM_MODEL=deepseek-v4-pro        # 旗舰版，复杂推理时用
#
# 内网聚好看 higpt 网关（OpenAI 兼容，需 user_key 作为 query 参数，强制流式）：
#   LLM_BASE_URL=https://inner-apisix.hisense.com/higpt-new/v1
#   LLM_API_KEY=网关分配的 api_key
#   LLM_USER_KEY=网关分配的 user_key   # 仅聚好看需要；公网 DeepSeek 留空
#   LLM_MODEL=deepseek-v4-flash        # 亦可 qwen3-5-397b 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-key
LLM_USER_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60
LLM_MAX_RETRY=2

# 输出是否统一转简体（繁→简）。默认 true；设为 false 保留原文
OUTPUT_SIMPLIFIED=true

# 可选：trace / 反馈落盘位置
# TRACE_DIR=runs
# FEEDBACK_FILE=runs/feedback.jsonl
