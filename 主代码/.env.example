# ReportVerify LLM 运行配置示例（占位符，复制为 .env 后由受控环境注入真实值）
# ============================================================================
# 安全须知：
#   - .env 已被 .gitignore 忽略，禁止把真实 API_KEY / USER_KEY / endpoint 写入仓库、
#     文档、fixture、日志或提交记录。
#   - 生产安全基线是 MODE=off（仅确定性核对）。启用前先跑发布门禁：
#       python -m report_verify.llm.release_gate
#   - 下列值均为占位符；真实凭据只通过受控环境/secret store 注入。
# ============================================================================

# 运行模式：off | candidate | explain | candidate_explain
#   off              = 仅确定性核对（生产默认，最安全）
#   candidate        = 仅跨文档匹配候选
#   explain          = 仅差异解释
#   candidate_explain= 候选 + 解释
REPORT_VERIFY_LLM_MODE=off

# 复用 CertAgent 同一网关/模型/凭据（受控注入，占位示例）
REPORT_VERIFY_LLM_BASE_URL=https://<approved-host>/<approved-path>/v1
REPORT_VERIFY_LLM_MODEL=<approved-model>
REPORT_VERIFY_LLM_API_KEY=<injected-secret-not-written>
REPORT_VERIFY_LLM_USER_KEY=<optional-injected-secret-not-written>

# 服务器 allowlist：host 与允许的任务级 mode（off 永远隐式允许）
REPORT_VERIFY_LLM_ALLOWED_HOSTS=<approved-host>
REPORT_VERIFY_LLM_ALLOWED_MODES=off

# 原文/图片策略：允许字段原文（受字段白名单/字符/行数/脱敏约束）；图片固定硬拒绝
REPORT_VERIFY_LLM_ALLOW_ORIGINAL_TEXT=true
REPORT_VERIFY_LLM_ALLOW_IMAGES=false
# 是否允许明文（非 TLS）：默认禁止，仅受控环境显式开启
# REPORT_VERIFY_LLM_ALLOW_PLAINTEXT=false

# 超时与重试（秒）
REPORT_VERIFY_LLM_TIMEOUT=180
REPORT_VERIFY_LLM_TOTAL_TIMEOUT=600
# REPORT_VERIFY_LLM_MAX_RETRY=2

# 断路器
# REPORT_VERIFY_LLM_CIRCUIT_FAILURE_THRESHOLD=3
# REPORT_VERIFY_LLM_CIRCUIT_COOLDOWN=60

# 响应体字节上限与 max_tokens 安全阀（0=不限制，不写入请求体）
# REPORT_VERIFY_LLM_MAX_RESPONSE_BYTES=1048576
# REPORT_VERIFY_LLM_MAX_TOKENS=0

# 差异解释分批与并发：
#   EXPLAIN_BATCH_ROWS   单批行数（默认 50，小于策略 max_rows=200 以控墙钟）
#   EXPLAIN_MAX_DIFFS    单次最多解释多少条差异（默认 500，超出只解释前 N 条）
#   EXPLAIN_MAX_WORKERS  批次线程池并发度（默认 4，1=串行）
REPORT_VERIFY_LLM_EXPLAIN_BATCH_ROWS=50
REPORT_VERIFY_LLM_EXPLAIN_MAX_DIFFS=500
REPORT_VERIFY_LLM_EXPLAIN_MAX_WORKERS=4

# ---- Web / 任务（可选，均有默认值）----------------------------------------
# REPORT_VERIFY_DATA_DIR=runs/web_jobs
# REPORT_VERIFY_MAX_UPLOAD_MB=500
# REPORT_VERIFY_MAX_CONCURRENT_JOBS=2
# REPORT_VERIFY_COMMENT_AUTHOR=ReportVerify
# REPORT_VERIFY_COMMENT_INITIALS=RV
# REPORT_VERIFY_API_KEY=            # 若设置则所有 /api 需带 X-ReportVerify-Key 头
